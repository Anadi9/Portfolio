{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/work-with-me",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rescue/audit",
      "destination": "/audit?type=app",
      "permanent": true
    },
    {
      "source": "/rescue",
      "destination": "/production-ready",
      "permanent": true
    },
    {
      "source": "/products/production-kit/thanks",
      "destination": "/products/production-kit",
      "permanent": true
    },
    {
      "source": "/kit/thanks",
      "destination": "/products/production-kit",
      "permanent": true
    },
    {
      "source": "/kit/downloads/:token",
      "destination": "/products/production-kit",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "has": [
        {
          "type": "host",
          "value": "anadithakur.in"
        }
      ],
      "destination": "https://portfolio.anadithakur.in/",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "has": [
        {
          "type": "host",
          "value": "www.anadithakur.in"
        }
      ],
      "destination": "https://portfolio.anadithakur.in/",
      "permanent": true
    },
    {
      "source": "/:path((?!assets/|api/|portfolio$)(?!.*\\.).+)",
      "has": [
        {
          "type": "host",
          "value": "portfolio.anadithakur.in"
        }
      ],
      "destination": "https://anadithakur.in/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://cloudflareinsights.com https://*.supabase.co wss://*.supabase.co; frame-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/admin-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/portal",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ping",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/care",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/summary",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/heartbeat",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/notify",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/scorecard",
      "schedule": "0 8 * * *"
    }
  ]
}
