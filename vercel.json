{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/production-kit-download.ts": {
      "includeFiles": "products/production-kit/**"
    }
  },
  "redirects": [
    {
      "source": "/work-with-me",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rescue/audit",
      "destination": "/audit?type=app",
      "permanent": true
    },
    {
      "source": "/rescue",
      "destination": "/production-ready",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "has": [
        {
          "type": "host",
          "value": "anadithakur.in"
        }
      ],
      "destination": "https://portfolio.anadithakur.in/",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "has": [
        {
          "type": "host",
          "value": "www.anadithakur.in"
        }
      ],
      "destination": "https://portfolio.anadithakur.in/",
      "permanent": true
    },
    {
      "source": "/:path((?!assets/|api/|portfolio$)(?!.*\\.).+)",
      "has": [
        {
          "type": "host",
          "value": "portfolio.anadithakur.in"
        }
      ],
      "destination": "https://anadithakur.in/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/kit/downloads/:token",
      "destination": "/kit/downloads/_"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.stripe.com\")"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://va.vercel-scripts.com https://api.stripe.com https://checkout.stripe.com https://*.supabase.co wss://*.supabase.co; frame-src 'self' https://js.stripe.com https://checkout.stripe.com; form-action 'self' https://checkout.stripe.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/kit/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/kit/ping",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/heartbeat",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/notify",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/scorecard",
      "schedule": "0 8 * * *"
    }
  ]
}
